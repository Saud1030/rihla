# ---------- Database ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rihla

# ---------- Site ----------
# Public URL of the site. MyFatoorah sends customers back to this address after
# paying, so it must be a real public https URL (localhost is rejected by MyFatoorah).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin ----------
# Long random string (at least 32 chars) used to sign admin sessions
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---------- MyFatoorah ----------
# API key (token) from the MyFatoorah portal -> Integration Settings -> API Key
MYFATOORAH_API_KEY=
# Test:  https://apitest.myfatoorah.com
# Live (Saudi Arabia): https://api-sa.myfatoorah.com
MYFATOORAH_API_BASE=https://apitest.myfatoorah.com
# Webhook secret key from the MyFatoorah portal -> Integration Settings -> Webhook (V2)
MYFATOORAH_WEBHOOK_SECRET=

# ---------- WhatsApp Business (Cloud API by Meta) ----------
# Optional. Without these, driver/customer/rating messages wait in the admin panel with a "send on WhatsApp" button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# ---------- E-invoicing (Wafeq) ----------
# Optional. The API key and accounts are set in Admin -> Settings -> E-invoicing; this only changes the API address (tests).
# WAFEQ_API_BASE=https://api.wafeq.com/v1

# ---------- Email (SMTP) ----------
# Optional. New ratings are emailed to the company email (admin -> Messages).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Server (VPS) ----------
# Database password for docker compose (the app's DATABASE_URL is built from it there)
# POSTGRES_PASSWORD=
# Background jobs (finish trips, rating requests, message retries) run inside the app every 5 minutes.
# Set DISABLE_SWEEP=1 only if you call /api/admin/sweep from an outside scheduler instead,
# with the header "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=
# DISABLE_SWEEP=1
# Extra public host names in front of the app, comma separated (only if forms say "invalid origin")
# SERVER_ACTIONS_ALLOWED_ORIGINS=
