# ---------- Database ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rihla

# ---------- Site ----------
# Public URL of the site. MyFatoorah sends customers back to this address after
# paying, so it must be a real public https URL (localhost is rejected by MyFatoorah).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin ----------
# Long random string (at least 32 chars) used to sign admin sessions
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---------- MyFatoorah ----------
# API key (token) from the MyFatoorah portal -> Integration Settings -> API Key
MYFATOORAH_API_KEY=
# Test:  https://apitest.myfatoorah.com
# Live (Saudi Arabia): https://api-sa.myfatoorah.com
MYFATOORAH_API_BASE=https://apitest.myfatoorah.com
# Webhook secret key from the MyFatoorah portal -> Integration Settings -> Webhook (V2)
MYFATOORAH_WEBHOOK_SECRET=

# ---------- WhatsApp Business (Cloud API by Meta) ----------
# Optional. Without these, driver/customer/rating messages wait in the admin panel with a "send on WhatsApp" button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# ---------- Email (SMTP) ----------
# Optional. New ratings are emailed to the company email (admin -> Messages).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
